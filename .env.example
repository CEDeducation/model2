# Browser-safe Supabase project settings. These are intentionally NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only Scientific Sandbox model settings.
# Never expose OPENAI_API_KEY to the browser. OpenLab sets store:false on model calls.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional identification / higher-rate settings for official scientific APIs.
# The sandbox still works without these for light use.
NCBI_API_KEY=
NCBI_EMAIL=
CROSSREF_MAILTO=
